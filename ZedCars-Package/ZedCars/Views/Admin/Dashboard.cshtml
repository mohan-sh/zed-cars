@{
    ViewBag.Title = "Admin Dashboard";
    Layout = "~/Views/Shared/_SimpleLayout.cshtml";
}

<div class="admin-header">
    <h1>Admin Dashboard</h1>
    <p class="lead">Manage your ZedCars inventory and users</p>
    
    <div class="admin-actions">
        <a href="/Admin/AddVehicle" class="btn btn-primary">Add New Vehicle</a>
        <a href="/Admin/Inventory" class="btn btn-primary">Edit / Delete Vehicle</a>
        <a href="/Admin/ManageUsers" class="btn btn-secondary">Manage Users</a>
        <a href="/Admin/Reports" class="btn btn-secondary">View Reports</a>
    </div>
</div>

<div class="dashboard-summary">
    <div class="summary-card">
        <div class="summary-icon sales-icon">&#128176;</div>
        <div class="summary-content">
            <div class="summary-title">Monthly Revenue</div>
            <div class="summary-value">$128,450</div>
            <div class="summary-change positive">+12.5% from last month</div>
        </div>
    </div>
    
    <div class="summary-card">
        <div class="summary-icon visitors-icon">&#128101;</div>
        <div class="summary-content">
            <div class="summary-title">Website Visitors</div>
            <div class="summary-value">5,280</div>
            <div class="summary-change positive">+8.3% from last month</div>
        </div>
    </div>
    
    <div class="summary-card">
        <div class="summary-icon conversion-icon">&#128200;</div>
        <div class="summary-content">
            <div class="summary-title">Conversion Rate</div>
            <div class="summary-value">3.2%</div>
            <div class="summary-change negative">-0.5% from last month</div>
        </div>
    </div>
    
    <div class="summary-card">
        <div class="summary-icon inventory-icon">&#9632;</div>
        <div class="summary-content">
            <div class="summary-title">Inventory Value</div>
            <div class="summary-value">$1.2M</div>
            <div class="summary-change positive">+5.1% from last month</div>
        </div>
    </div>
</div>

<div class="admin-stats">
    <div class="stat-card">
        <div class="stat-value">@ViewBag.TotalVehicles</div>
        <div class="stat-label">Total Vehicles</div>
    </div>
    
    <div class="stat-card">
        <div class="stat-value">@ViewBag.TotalBrands</div>
        <div class="stat-label">Vehicle Brands</div>
    </div>
    
    <div class="stat-card">
        <div class="stat-value">@ViewBag.TotalUsers</div>
        <div class="stat-label">Registered Users</div>
    </div>
    
    <div class="stat-card">
        <div class="stat-value">$@string.Format("{0:N0}", ViewBag.InventoryValue)</div>
        <div class="stat-label">Inventory Value</div>
    </div>
</div>

<div class="analytics-section">
    <div class="analytics-header">
        <h2>Sales Analytics</h2>
        <div class="analytics-period">
            <select id="period-selector">
                <option value="week">Last Week</option>
                <option value="month" selected>Last Month</option>
                <option value="quarter">Last Quarter</option>
                <option value="year">Last Year</option>
            </select>
        </div>
    </div>
    
    <div class="analytics-grid">
        <div class="analytics-chart">
            <div class="chart-header">
                <h3>Sales Performance</h3>
                <div class="chart-legend">
                    <span class="legend-item"><span class="legend-color" style="background-color: #4e73df;"></span> This Period</span>
                    <span class="legend-item"><span class="legend-color" style="background-color: #e74a3b;"></span> Previous Period</span>
                </div>
            </div>
            <div class="chart-container">
                <div class="chart-placeholder">
                    <div class="chart-bar" style="height: 60%;"></div>
                    <div class="chart-bar" style="height: 75%;"></div>
                    <div class="chart-bar" style="height: 45%;"></div>
                    <div class="chart-bar" style="height: 85%;"></div>
                    <div class="chart-bar" style="height: 70%;"></div>
                    <div class="chart-bar" style="height: 90%;"></div>
                    <div class="chart-bar" style="height: 55%;"></div>
                </div>
                <div class="chart-labels">
                    <span>Mon</span>
                    <span>Tue</span>
                    <span>Wed</span>
                    <span>Thu</span>
                    <span>Fri</span>
                    <span>Sat</span>
                    <span>Sun</span>
                </div>
            </div>
        </div>
        
        <div class="analytics-chart">
            <div class="chart-header">
                <h3>Popular Vehicle Types</h3>
            </div>
            <div class="chart-container">
                <div class="pie-chart-placeholder">
                    <div class="pie-segment sedan" style="--percentage: 35%;">Sedan (35%)</div>
                    <div class="pie-segment suv" style="--percentage: 28%;">SUV (28%)</div>
                    <div class="pie-segment truck" style="--percentage: 20%;">Truck (20%)</div>
                    <div class="pie-segment sports" style="--percentage: 17%;">Sports (17%)</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="recent-activity">
    <h2>Recently Added Vehicles</h2>
    <div class="activity-list">
        @if (ViewBag.RecentCars != null)
        {
            foreach (var car in ViewBag.RecentCars)
            {
                <div class="activity-item">
                    <div class="activity-icon">[V]</div>
                    <div class="activity-content">
                        <div class="activity-title">@car</div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<style>
    .admin-header {
        background: linear-gradient(135deg, #dc3545 0%, #fd7e14 100%);
        color: white;
        padding: 40px 20px;
        text-align: center;
        margin: -30px -30px 40px -30px;
        border-radius: 8px 8px 0 0;
    }
    
    .admin-actions {
        display: flex;
        justify-content: center;
        gap: 15px;
        margin-top: 20px;
        flex-wrap: wrap;
    }
    
    .btn {
        display: inline-block;
        padding: 10px 20px;
        border: none;
        border-radius: 4px;
        text-decoration: none;
        text-align: center;
        cursor: pointer;
        font-weight: bold;
        transition: all 0.3s;
    }
    
    .btn-primary {
        background: #007bff;
        color: white;
    }
    
    .btn-secondary {
        background: #6c757d;
        color: white;
    }
    
    .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    }
    
    .dashboard-summary {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }
    
    .summary-card {
        background: white;
        padding: 25px;
        border-radius: 8px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        display: flex;
        align-items: center;
        gap: 20px;
    }
    
    .summary-icon {
        font-size: 3em;
        flex-shrink: 0;
    }
    
    .summary-content {
        flex: 1;
    }
    
    .summary-title {
        color: #6c757d;
        font-size: 0.9em;
        margin-bottom: 5px;
    }
    
    .summary-value {
        font-size: 2em;
        font-weight: bold;
        color: #343a40;
        margin-bottom: 5px;
    }
    
    .summary-change {
        font-size: 0.8em;
        font-weight: bold;
    }
    
    .summary-change.positive {
        color: #28a745;
    }
    
    .summary-change.negative {
        color: #dc3545;
    }
    
    .admin-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }
    
    .stat-card {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 8px;
        text-align: center;
        border-left: 4px solid #007bff;
    }
    
    .stat-value {
        font-size: 2.5em;
        font-weight: bold;
        color: #007bff;
        margin-bottom: 5px;
    }
    
    .stat-label {
        color: #6c757d;
        font-size: 0.9em;
    }
    
    .analytics-section {
        background: white;
        padding: 30px;
        border-radius: 8px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        margin-bottom: 30px;
    }
    
    .analytics-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }
    
    .analytics-header h2 {
        margin: 0;
        color: #343a40;
    }
    
    .analytics-period select {
        padding: 8px 12px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        background: white;
    }
    
    .analytics-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 30px;
    }
    
    .analytics-chart {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 8px;
    }
    
    .chart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }
    
    .chart-header h3 {
        margin: 0;
        color: #343a40;
    }
    
    .chart-legend {
        display: flex;
        gap: 15px;
    }
    
    .legend-item {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 0.9em;
    }
    
    .legend-color {
        width: 12px;
        height: 12px;
        border-radius: 2px;
    }
    
    .chart-container {
        position: relative;
    }
    
    .chart-placeholder {
        display: flex;
        align-items: end;
        justify-content: space-around;
        height: 200px;
        background: white;
        border-radius: 4px;
        padding: 20px;
    }
    
    .chart-bar {
        width: 30px;
        background: linear-gradient(to top, #4e73df, #36b9cc);
        border-radius: 4px 4px 0 0;
        transition: all 0.3s;
    }
    
    .chart-bar:hover {
        opacity: 0.8;
    }
    
    .chart-labels {
        display: flex;
        justify-content: space-around;
        margin-top: 10px;
        font-size: 0.9em;
        color: #6c757d;
    }
    
    .pie-chart-placeholder {
        background: white;
        border-radius: 4px;
        padding: 20px;
        text-align: center;
    }
    
    .pie-segment {
        padding: 10px;
        margin: 5px 0;
        border-radius: 4px;
        font-weight: bold;
    }
    
    .pie-segment.sedan {
        background: #4e73df;
        color: white;
    }
    
    .pie-segment.suv {
        background: #1cc88a;
        color: white;
    }
    
    .pie-segment.truck {
        background: #36b9cc;
        color: white;
    }
    
    .pie-segment.sports {
        background: #f6c23e;
        color: #333;
    }
    
    .recent-activity {
        background: white;
        padding: 30px;
        border-radius: 8px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }
    
    .recent-activity h2 {
        margin: 0 0 20px 0;
        color: #343a40;
    }
    
    .activity-list {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }
    
    .activity-item {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 15px;
        background: #f8f9fa;
        border-radius: 8px;
        border-left: 4px solid #28a745;
    }
    
    .activity-icon {
        font-size: 1.5em;
        flex-shrink: 0;
    }
    
    .activity-content {
        flex: 1;
    }
    
    .activity-title {
        color: #343a40;
        font-weight: bold;
        margin-bottom: 3px;
    }
    
    .activity-time {
        color: #6c757d;
        font-size: 0.9em;
    }
    
    @@media (max-width: 768px) {
        .analytics-grid {
            grid-template-columns: 1fr;
        }
        
        .admin-actions {
            flex-direction: column;
            align-items: center;
        }
        
        .analytics-header {
            flex-direction: column;
            gap: 15px;
            align-items: flex-start;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const periodSelector = document.getElementById('period-selector');
        
        periodSelector.addEventListener('change', function() {
            // In a real application, this would update the charts with new data
            console.log('Period changed to:', this.value);
        });
        
        // Animate chart bars on load
        const chartBars = document.querySelectorAll('.chart-bar');
        chartBars.forEach((bar, index) => {
            setTimeout(() => {
                bar.style.opacity = '1';
                bar.style.transform = 'scaleY(1)';
            }, index * 100);
        });
    });
</script>
