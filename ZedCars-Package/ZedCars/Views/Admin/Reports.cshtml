@{
    ViewBag.Title = "Reports";
    Layout = "~/Views/Shared/_SimpleLayout.cshtml";
}

<div class="admin-header">
    <h1>Reports & Analytics</h1>
    <p class="lead">Business intelligence and performance metrics</p>
    
    <div class="admin-actions">
        <a href="/Admin/Dashboard" class="btn btn-secondary">Back to Dashboard</a>
        <a href="/Admin/ManageUsers" class="btn btn-secondary">Manage Users</a>
    </div>
</div>

<div class="reports-container">
    <div class="report-filters">
        <div class="filter-group">
            <label for="date-range">Date Range:</label>
            <select id="date-range" class="form-control">
                <option value="7">Last 7 Days</option>
                <option value="30" selected>Last 30 Days</option>
                <option value="90">Last 90 Days</option>
                <option value="365">Last Year</option>
                <option value="custom">Custom Range</option>
            </select>
        </div>
        
        <div class="filter-group">
            <label for="report-type">Report Type:</label>
            <select id="report-type" class="form-control">
                <option value="overview" selected>Overview</option>
                <option value="sales">Sales Report</option>
                <option value="inventory">Inventory Report</option>
                <option value="users">User Activity</option>
            </select>
        </div>
        
        <button id="generate-report" class="btn btn-primary">Generate Report</button>
        <button id="export-report" class="btn btn-outline">Export PDF</button>
    </div>
    
    <div class="report-summary">
        <div class="summary-card">
            <div class="summary-icon">&#128176;</div>
            <div class="summary-content">
                <div class="summary-title">Inventory Value</div>
                <div class="summary-value">$@string.Format("{0:N0}", ViewBag.InventoryValue)</div>
            </div>
        </div>
        <div class="summary-card">
            <div class="summary-icon">&#9632;</div>
            <div class="summary-content">
                <div class="summary-title">Total Vehicles</div>
                <div class="summary-value">@ViewBag.TotalVehicles</div>
            </div>
        </div>
        <div class="summary-card">
            <div class="summary-icon">&#128101;</div>
            <div class="summary-content">
                <div class="summary-title">Registered Users</div>
                <div class="summary-value">@ViewBag.TotalUsers</div>
            </div>
        </div>
        <div class="summary-card">
            <div class="summary-icon">&#128200;</div>
            <div class="summary-content">
                <div class="summary-title">Brands</div>
                <div class="summary-value">@ViewBag.TotalBrands</div>
            </div>
        </div>
    </div>

    <div id="report-content" class="reports-grid">
        <div class="report-section">
            <div class="report-header"><h3>Vehicles by Brand</h3></div>
            <div class="brand-stats">
                @if (ViewBag.BrandStats != null)
                {
                    int maxCount = 1;
                    foreach (object[] b in ViewBag.BrandStats)
                    {
                        if (Convert.ToInt32(b[1]) > maxCount) { maxCount = Convert.ToInt32(b[1]); }
                    }

                    foreach (object[] b in ViewBag.BrandStats)
                    {
                        int pct = (int)(Convert.ToDouble(b[1]) / maxCount * 100);
                        <div class="brand-item">
                            <div class="brand-info">
                                <span class="brand-name">@b[0]</span>
                                <span class="brand-count">@b[1] vehicles</span>
                            </div>
                            <div class="brand-bar">
                                <div class="brand-progress" style="width:@pct%;"></div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="report-section">
            <div class="report-header"><h3>Recently Added Vehicles</h3></div>
            <div class="transactions-list">
                @if (ViewBag.RecentCars != null)
                {
                    foreach (object[] c in ViewBag.RecentCars)
                    {
                        <div class="transaction-item">
                            <div class="transaction-info">
                                <div class="transaction-vehicle">@c[0]</div>
                                <div class="transaction-date">@Convert.ToDateTime(c[2]).ToString("MMM dd, yyyy")</div>
                            </div>
                            <div class="transaction-amount">$@string.Format("{0:N0}", c[1])</div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<style>
    .admin-header {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
        padding: 40px 20px;
        text-align: center;
        margin: -30px -30px 40px -30px;
        border-radius: 8px 8px 0 0;
    }
    
    .admin-actions {
        display: flex;
        justify-content: center;
        gap: 15px;
        margin-top: 20px;
        flex-wrap: wrap;
    }
    
    .btn {
        display: inline-block;
        padding: 8px 16px;
        border: none;
        border-radius: 4px;
        text-decoration: none;
        text-align: center;
        cursor: pointer;
        font-weight: bold;
        transition: all 0.3s;
    }
    
    .btn-primary {
        background: #28a745;
        color: white;
    }
    
    .btn-secondary {
        background: #6c757d;
        color: white;
    }
    
    .btn-outline {
        background: transparent;
        border: 1px solid #6c757d;
        color: #6c757d;
    }
    
    .btn-sm {
        padding: 4px 8px;
        font-size: 0.9em;
    }
    
    .reports-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }
    
    .report-filters {
        background: white;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        margin-bottom: 20px;
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
        align-items: end;
    }
    
    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }
    
    .filter-group label {
        font-weight: bold;
        color: #495057;
        font-size: 0.9em;
    }
    
    .form-control {
        padding: 8px 12px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        font-size: 14px;
        min-width: 150px;
    }
    
    .report-summary {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }
    
    .summary-card {
        background: white;
        padding: 25px;
        border-radius: 8px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        display: flex;
        align-items: center;
        gap: 20px;
    }
    
    .summary-icon {
        font-size: 3em;
        flex-shrink: 0;
    }
    
    .summary-content {
        flex: 1;
    }
    
    .summary-title {
        color: #6c757d;
        font-size: 0.9em;
        margin-bottom: 5px;
    }
    
    .summary-value {
        font-size: 2em;
        font-weight: bold;
        color: #343a40;
        margin-bottom: 5px;
    }
    
    .summary-change {
        font-size: 0.8em;
        font-weight: bold;
    }
    
    .summary-change.positive {
        color: #28a745;
    }
    
    .summary-change.negative {
        color: #dc3545;
    }
    
    .reports-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
    }
    
    .report-section {
        background: white;
        border-radius: 8px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        overflow: hidden;
    }
    
    .report-header {
        padding: 20px;
        border-bottom: 1px solid #dee2e6;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    
    .report-header h3 {
        margin: 0;
        color: #343a40;
    }
    
    .chart-container {
        padding: 20px;
    }
    
    .sales-chart {
        display: flex;
        align-items: end;
        justify-content: space-around;
        height: 200px;
        gap: 10px;
    }
    
    .chart-bar {
        flex: 1;
        background: linear-gradient(to top, #28a745, #20c997);
        border-radius: 4px 4px 0 0;
        display: flex;
        align-items: end;
        justify-content: center;
        color: white;
        font-weight: bold;
        font-size: 0.8em;
        padding: 5px;
        cursor: pointer;
        transition: opacity 0.3s;
    }
    
    .chart-bar:hover {
        opacity: 0.8;
    }
    
    .brand-stats {
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 15px;
    }
    
    .brand-item {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }
    
    .brand-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    
    .brand-name {
        font-weight: bold;
        color: #343a40;
    }
    
    .brand-count {
        color: #6c757d;
        font-size: 0.9em;
    }
    
    .brand-bar {
        height: 8px;
        background: #e9ecef;
        border-radius: 4px;
        overflow: hidden;
    }
    
    .brand-progress {
        height: 100%;
        background: linear-gradient(to right, #28a745, #20c997);
        transition: width 0.3s;
    }
    
    .transactions-list {
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 15px;
    }
    
    .transaction-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px;
        background: #f8f9fa;
        border-radius: 4px;
    }
    
    .transaction-vehicle {
        font-weight: bold;
        color: #343a40;
    }
    
    .transaction-date {
        color: #6c757d;
        font-size: 0.9em;
    }
    
    .transaction-amount {
        font-weight: bold;
        color: #28a745;
    }
    
    .activity-stats {
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 15px;
    }
    
    .activity-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px;
        background: #f8f9fa;
        border-radius: 4px;
    }
    
    .activity-label {
        color: #495057;
    }
    
    .activity-value {
        font-weight: bold;
        color: #28a745;
        font-size: 1.2em;
    }
    
    @@media (max-width: 768px) {
        .reports-container {
            padding: 10px;
        }
        
        .report-filters {
            flex-direction: column;
            align-items: stretch;
        }
        
        .reports-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script>
    document.getElementById('generate-report').addEventListener('click', function() {
        window.location.href = '/Admin/Reports';
    });

    document.getElementById('export-report').addEventListener('click', function() {
        var btn = this;
        btn.textContent = 'Generating...';
        btn.disabled = true;

        html2canvas(document.getElementById('report-content')).then(function(canvas) {
            var imgData = canvas.toDataURL('image/png');
            var pdf = new window.jspdf.jsPDF('p', 'mm', 'a4');
            var pageWidth = pdf.internal.pageSize.getWidth();
            var imgHeight = canvas.height * pageWidth / canvas.width;
            pdf.addImage(imgData, 'PNG', 0, 0, pageWidth, imgHeight);
            pdf.save('ZedCars-Report.pdf');
            btn.textContent = 'Export PDF';
            btn.disabled = false;
        });
    });
</script>
