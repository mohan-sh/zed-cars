@{
    ViewBag.Title = "Reports";
    Layout = "~/Views/Shared/_SimpleLayout.cshtml";
}

<div class="admin-header">
    <h1>Reports & Analytics</h1>
    <p class="lead">Business intelligence and performance metrics</p>
    
    <div class="admin-actions">
        <a href="/Admin/Dashboard" class="btn btn-secondary">Back to Dashboard</a>
        <a href="/Admin/ManageUsers" class="btn btn-secondary">Manage Users</a>
    </div>
</div>

<div class="reports-container">
    <div class="report-filters">
        <div class="filter-group">
            <label for="date-range">Date Range:</label>
            <select id="date-range" class="form-control">
                <option value="7">Last 7 Days</option>
                <option value="30" selected>Last 30 Days</option>
                <option value="90">Last 90 Days</option>
                <option value="365">Last Year</option>
                <option value="custom">Custom Range</option>
            </select>
        </div>
        
        <div class="filter-group">
            <label for="report-type">Report Type:</label>
            <select id="report-type" class="form-control">
                <option value="overview" selected>Overview</option>
                <option value="sales">Sales Report</option>
                <option value="inventory">Inventory Report</option>
                <option value="users">User Activity</option>
            </select>
        </div>
        
        <button id="generate-report" class="btn btn-primary">Generate Report</button>
        <button id="export-report" class="btn btn-outline">Export PDF</button>
    </div>
    
    <div class="report-summary">
        <div class="summary-card revenue">
            <div class="summary-icon">&#128176;</div>
            <div class="summary-content">
                <div class="summary-title">Total Revenue</div>
                <div class="summary-value">$384,750</div>
                <div class="summary-change positive">+18.5% vs last period</div>
            </div>
        </div>
        
        <div class="summary-card sales">
            <div class="summary-icon">&#9632;</div>
            <div class="summary-content">
                <div class="summary-title">Vehicles Sold</div>
                <div class="summary-value">47</div>
                <div class="summary-change positive">+12.3% vs last period</div>
            </div>
        </div>
        
        <div class="summary-card inquiries">
            <div class="summary-icon">&#128231;</div>
            <div class="summary-content">
                <div class="summary-title">Customer Inquiries</div>
                <div class="summary-value">156</div>
                <div class="summary-change positive">+8.7% vs last period</div>
            </div>
        </div>
        
        <div class="summary-card conversion">
            <div class="summary-icon">&#128200;</div>
            <div class="summary-content">
                <div class="summary-title">Conversion Rate</div>
                <div class="summary-value">30.1%</div>
                <div class="summary-change negative">-2.1% vs last period</div>
            </div>
        </div>
    </div>
    
    <div class="reports-grid">
        <div class="report-section">
            <div class="report-header">
                <h3>Sales Performance</h3>
                <div class="report-actions">
                    <button class="btn btn-sm btn-outline">View Details</button>
                </div>
            </div>
            <div class="chart-container">
                <div class="sales-chart">
                    <div class="chart-bar" style="height: 60%;" data-value="$45,000">Week 1</div>
                    <div class="chart-bar" style="height: 80%;" data-value="$60,000">Week 2</div>
                    <div class="chart-bar" style="height: 45%;" data-value="$33,750">Week 3</div>
                    <div class="chart-bar" style="height: 95%;" data-value="$71,250">Week 4</div>
                </div>
            </div>
        </div>
        
        <div class="report-section">
            <div class="report-header">
                <h3>Top Selling Brands</h3>
                <div class="report-actions">
                    <button class="btn btn-sm btn-outline">View Details</button>
                </div>
            </div>
            <div class="brand-stats">
                <div class="brand-item">
                    <div class="brand-info">
                        <span class="brand-name">BMW</span>
                        <span class="brand-count">12 sold</span>
                    </div>
                    <div class="brand-bar">
                        <div class="brand-progress" style="width: 85%;"></div>
                    </div>
                </div>
                
                <div class="brand-item">
                    <div class="brand-info">
                        <span class="brand-name">Tesla</span>
                        <span class="brand-count">10 sold</span>
                    </div>
                    <div class="brand-bar">
                        <div class="brand-progress" style="width: 70%;"></div>
                    </div>
                </div>
                
                <div class="brand-item">
                    <div class="brand-info">
                        <span class="brand-name">Toyota</span>
                        <span class="brand-count">8 sold</span>
                    </div>
                    <div class="brand-bar">
                        <div class="brand-progress" style="width: 55%;"></div>
                    </div>
                </div>
                
                <div class="brand-item">
                    <div class="brand-info">
                        <span class="brand-name">Honda</span>
                        <span class="brand-count">7 sold</span>
                    </div>
                    <div class="brand-bar">
                        <div class="brand-progress" style="width: 50%;"></div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="report-section">
            <div class="report-header">
                <h3>Recent Transactions</h3>
                <div class="report-actions">
                    <button class="btn btn-sm btn-outline">View All</button>
                </div>
            </div>
            <div class="transactions-list">
                <div class="transaction-item">
                    <div class="transaction-info">
                        <div class="transaction-vehicle">BMW 5 Series</div>
                        <div class="transaction-date">2 days ago</div>
                    </div>
                    <div class="transaction-amount">$55,000</div>
                </div>
                
                <div class="transaction-item">
                    <div class="transaction-info">
                        <div class="transaction-vehicle">Tesla Model 3</div>
                        <div class="transaction-date">5 days ago</div>
                    </div>
                    <div class="transaction-amount">$60,000</div>
                </div>
                
                <div class="transaction-item">
                    <div class="transaction-info">
                        <div class="transaction-vehicle">Honda CR-V</div>
                        <div class="transaction-date">1 week ago</div>
                    </div>
                    <div class="transaction-amount">$35,000</div>
                </div>
                
                <div class="transaction-item">
                    <div class="transaction-info">
                        <div class="transaction-vehicle">Ford F-150</div>
                        <div class="transaction-date">1 week ago</div>
                    </div>
                    <div class="transaction-amount">$45,000</div>
                </div>
            </div>
        </div>
        
        <div class="report-section">
            <div class="report-header">
                <h3>Customer Activity</h3>
                <div class="report-actions">
                    <button class="btn btn-sm btn-outline">View Details</button>
                </div>
            </div>
            <div class="activity-stats">
                <div class="activity-item">
                    <div class="activity-label">New Registrations</div>
                    <div class="activity-value">23</div>
                </div>
                
                <div class="activity-item">
                    <div class="activity-label">Test Drive Requests</div>
                    <div class="activity-value">45</div>
                </div>
                
                <div class="activity-item">
                    <div class="activity-label">Financing Applications</div>
                    <div class="activity-value">18</div>
                </div>
                
                <div class="activity-item">
                    <div class="activity-label">Contact Form Submissions</div>
                    <div class="activity-value">67</div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .admin-header {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
        padding: 40px 20px;
        text-align: center;
        margin: -30px -30px 40px -30px;
        border-radius: 8px 8px 0 0;
    }
    
    .admin-actions {
        display: flex;
        justify-content: center;
        gap: 15px;
        margin-top: 20px;
        flex-wrap: wrap;
    }
    
    .btn {
        display: inline-block;
        padding: 8px 16px;
        border: none;
        border-radius: 4px;
        text-decoration: none;
        text-align: center;
        cursor: pointer;
        font-weight: bold;
        transition: all 0.3s;
    }
    
    .btn-primary {
        background: #28a745;
        color: white;
    }
    
    .btn-secondary {
        background: #6c757d;
        color: white;
    }
    
    .btn-outline {
        background: transparent;
        border: 1px solid #6c757d;
        color: #6c757d;
    }
    
    .btn-sm {
        padding: 4px 8px;
        font-size: 0.9em;
    }
    
    .reports-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }
    
    .report-filters {
        background: white;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        margin-bottom: 20px;
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
        align-items: end;
    }
    
    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }
    
    .filter-group label {
        font-weight: bold;
        color: #495057;
        font-size: 0.9em;
    }
    
    .form-control {
        padding: 8px 12px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        font-size: 14px;
        min-width: 150px;
    }
    
    .report-summary {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }
    
    .summary-card {
        background: white;
        padding: 25px;
        border-radius: 8px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        display: flex;
        align-items: center;
        gap: 20px;
    }
    
    .summary-icon {
        font-size: 3em;
        flex-shrink: 0;
    }
    
    .summary-content {
        flex: 1;
    }
    
    .summary-title {
        color: #6c757d;
        font-size: 0.9em;
        margin-bottom: 5px;
    }
    
    .summary-value {
        font-size: 2em;
        font-weight: bold;
        color: #343a40;
        margin-bottom: 5px;
    }
    
    .summary-change {
        font-size: 0.8em;
        font-weight: bold;
    }
    
    .summary-change.positive {
        color: #28a745;
    }
    
    .summary-change.negative {
        color: #dc3545;
    }
    
    .reports-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
    }
    
    .report-section {
        background: white;
        border-radius: 8px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        overflow: hidden;
    }
    
    .report-header {
        padding: 20px;
        border-bottom: 1px solid #dee2e6;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    
    .report-header h3 {
        margin: 0;
        color: #343a40;
    }
    
    .chart-container {
        padding: 20px;
    }
    
    .sales-chart {
        display: flex;
        align-items: end;
        justify-content: space-around;
        height: 200px;
        gap: 10px;
    }
    
    .chart-bar {
        flex: 1;
        background: linear-gradient(to top, #28a745, #20c997);
        border-radius: 4px 4px 0 0;
        display: flex;
        align-items: end;
        justify-content: center;
        color: white;
        font-weight: bold;
        font-size: 0.8em;
        padding: 5px;
        cursor: pointer;
        transition: opacity 0.3s;
    }
    
    .chart-bar:hover {
        opacity: 0.8;
    }
    
    .brand-stats {
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 15px;
    }
    
    .brand-item {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }
    
    .brand-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    
    .brand-name {
        font-weight: bold;
        color: #343a40;
    }
    
    .brand-count {
        color: #6c757d;
        font-size: 0.9em;
    }
    
    .brand-bar {
        height: 8px;
        background: #e9ecef;
        border-radius: 4px;
        overflow: hidden;
    }
    
    .brand-progress {
        height: 100%;
        background: linear-gradient(to right, #28a745, #20c997);
        transition: width 0.3s;
    }
    
    .transactions-list {
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 15px;
    }
    
    .transaction-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px;
        background: #f8f9fa;
        border-radius: 4px;
    }
    
    .transaction-vehicle {
        font-weight: bold;
        color: #343a40;
    }
    
    .transaction-date {
        color: #6c757d;
        font-size: 0.9em;
    }
    
    .transaction-amount {
        font-weight: bold;
        color: #28a745;
    }
    
    .activity-stats {
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 15px;
    }
    
    .activity-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px;
        background: #f8f9fa;
        border-radius: 4px;
    }
    
    .activity-label {
        color: #495057;
    }
    
    .activity-value {
        font-weight: bold;
        color: #28a745;
        font-size: 1.2em;
    }
    
    @@media (max-width: 768px) {
        .reports-container {
            padding: 10px;
        }
        
        .report-filters {
            flex-direction: column;
            align-items: stretch;
        }
        
        .reports-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const dateRange = document.getElementById('date-range');
        const reportType = document.getElementById('report-type');
        const generateBtn = document.getElementById('generate-report');
        const exportBtn = document.getElementById('export-report');
        
        generateBtn.addEventListener('click', function() {
            const range = dateRange.value;
            const type = reportType.value;
            
            // Simulate report generation
            this.textContent = 'Generating...';
            this.disabled = true;
            
            setTimeout(() => {
                this.textContent = 'Generate Report';
                this.disabled = false;
                alert(`Generated ${type} report for ${range} days`);
            }, 2000);
        });
        
        exportBtn.addEventListener('click', function() {
            alert('Report export functionality would be implemented here');
        });
        
        // Add hover effects to chart bars
        document.querySelectorAll('.chart-bar').forEach(bar => {
            bar.addEventListener('mouseenter', function() {
                const value = this.dataset.value;
                if (value) {
                    this.title = value;
                }
            });
        });
        
        // Animate progress bars on load
        setTimeout(() => {
            document.querySelectorAll('.brand-progress').forEach(progress => {
                const width = progress.style.width;
                progress.style.width = '0%';
                setTimeout(() => {
                    progress.style.width = width;
                }, 100);
            });
        }, 500);
    });
</script>
