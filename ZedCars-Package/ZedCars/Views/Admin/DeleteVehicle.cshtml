@model ZedCars.Models.Car
@{
    ViewBag.Title = "Delete Vehicle";
    Layout = "~/Views/Shared/_SimpleLayout.cshtml";
}

<div class="admin-header">
    <h1>Delete Vehicle</h1>
    <p class="lead">Confirm vehicle deletion</p>
    <div class="admin-actions">
        <a href="/Admin/Inventory" class="btn btn-secondary">Cancel</a>
    </div>
</div>

<div class="delete-container">
    <div class="warning-section">
        <div class="warning-icon">&#9888;</div>
        <div class="warning-content">
            <h2>Are you sure you want to delete this vehicle?</h2>
            <p>This will mark the vehicle as inactive and remove it from the inventory.</p>
        </div>
    </div>

    <div class="vehicle-details">
        <table class="info-table">
            <tr><th>Brand</th><td>@Model.Brand</td></tr>
            <tr><th>Model</th><td>@Model.Model</td></tr>
            <tr><th>Year</th><td>@Model.Year</td></tr>
            <tr><th>Price</th><td>$@string.Format("{0:N0}", Model.Price)</td></tr>
        </table>
    </div>

    @using (Html.BeginForm("DeleteVehicle", "Admin", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.CarId" />
        <div class="form-actions">
            <button type="submit" class="btn btn-danger">Yes, Delete</button>
            <a href="/Admin/Inventory" class="btn btn-secondary">Cancel</a>
        </div>
    }
</div>

<style>
    .admin-header { background: linear-gradient(135deg, #dc3545 0%, #c82333 100%); color: white; padding: 40px 20px; text-align: center; margin: -30px -30px 40px -30px; border-radius: 8px 8px 0 0; }
    .admin-actions { display: flex; justify-content: center; gap: 15px; margin-top: 20px; }
    .btn { display: inline-block; padding: 10px 20px; border: none; border-radius: 4px; text-decoration: none; cursor: pointer; font-weight: bold; }
    .btn-danger { background: #dc3545; color: white; }
    .btn-secondary { background: #6c757d; color: white; }
    .delete-container { max-width: 600px; margin: 0 auto; }
    .warning-section { background: #fff3cd; border: 1px solid #ffeaa7; border-radius: 8px; padding: 20px; margin-bottom: 20px; display: flex; gap: 15px; align-items: center; }
    .warning-icon { font-size: 2.5em; }
    .warning-content h2 { color: #856404; margin: 0 0 5px 0; font-size: 1.1em; }
    .warning-content p { color: #856404; margin: 0; }
    .vehicle-details { background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); padding: 20px; margin-bottom: 20px; }
    .info-table { width: 100%; border-collapse: collapse; }
    .info-table th, .info-table td { padding: 10px; border-bottom: 1px solid #dee2e6; text-align: left; }
    .info-table th { color: #495057; width: 120px; }
    .form-actions { display: flex; gap: 15px; }
</style>
