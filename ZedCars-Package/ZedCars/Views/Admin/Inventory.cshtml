@model IEnumerable<ZedCars.Models.Car>
@{
    ViewBag.Title = "Admin Inventory";
    Layout = "~/Views/Shared/_SimpleLayout.cshtml";
}

<div class="admin-header">
    <h1>Inventory Management</h1>
    <p class="lead">Manage your vehicle inventory</p>
    <div class="admin-actions">
        <a href="/Admin/Dashboard" class="btn btn-secondary">Back to Dashboard</a>
        <a href="/Admin/AddVehicle" class="btn btn-primary">Add New Vehicle</a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <p style="color:green;font-weight:bold;padding:10px;">@TempData["SuccessMessage"]</p>
}
@if (TempData["ErrorMessage"] != null)
{
    <p style="color:red;font-weight:bold;padding:10px;">@TempData["ErrorMessage"]</p>
}

<div class="inventory-table-container">
    <table class="inventory-table">
        <thead>
            <tr>
                <th>Image</th>
                <th>Brand</th>
                <th>Model</th>
                <th>Year</th>
                <th>Price</th>
                <th>Fuel</th>
                <th>Transmission</th>
                <th>Stock</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var car in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(car.ImageUrl))
                        {
                            <img src="@car.ImageUrl" alt="@car.Brand @car.Model" class="vehicle-thumb" />
                        }
                    </td>
                    <td>@car.Brand</td>
                    <td>@car.Model</td>
                    <td>@car.Year</td>
                    <td class="price">$@string.Format("{0:N0}", car.Price)</td>
                    <td>@car.FuelType</td>
                    <td>@car.Transmission</td>
                    <td>@car.StockQuantity</td>
                    <td>
                        <div class="action-buttons">
                            <a href="/Admin/EditVehicle/@car.CarId" class="btn btn-sm btn-warning">Edit</a>
                            <a href="/Admin/DeleteVehicle/@car.CarId" class="btn btn-sm btn-danger">Delete</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<style>
    .admin-header { background: linear-gradient(135deg, #6f42c1 0%, #e83e8c 100%); color: white; padding: 40px 20px; text-align: center; margin: -30px -30px 40px -30px; border-radius: 8px 8px 0 0; }
    .admin-actions { display: flex; justify-content: center; gap: 15px; margin-top: 20px; flex-wrap: wrap; }
    .btn { display: inline-block; padding: 8px 16px; border: none; border-radius: 4px; text-decoration: none; cursor: pointer; font-weight: bold; }
    .btn-primary { background: #007bff; color: white; }
    .btn-secondary { background: #6c757d; color: white; }
    .btn-sm { padding: 4px 10px; font-size: 0.9em; }
    .btn-warning { background: #ffc107; color: #212529; }
    .btn-danger { background: #dc3545; color: white; }
    .inventory-table-container { background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); overflow: auto; }
    .inventory-table { width: 100%; border-collapse: collapse; }
    .inventory-table th { background: #f8f9fa; padding: 12px 10px; text-align: left; border-bottom: 2px solid #dee2e6; }
    .inventory-table td { padding: 12px 10px; border-bottom: 1px solid #dee2e6; vertical-align: middle; }
    .inventory-table tr:hover { background: #f8f9fa; }
    .vehicle-thumb { width: 60px; height: 45px; object-fit: cover; border-radius: 4px; }
    .price { font-weight: bold; color: #28a745; }
    .action-buttons { display: flex; gap: 5px; }
</style>
