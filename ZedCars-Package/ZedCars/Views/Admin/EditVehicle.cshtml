@model ZedCars.Models.Car
@{
    ViewBag.Title = "Edit Vehicle";
    Layout = "~/Views/Shared/_SimpleLayout.cshtml";
}

<div class="admin-header">
    <h1>Edit Vehicle</h1>
    <p class="lead">Update vehicle information</p>
    <div class="admin-actions">
        <a href="/Admin/Inventory" class="btn btn-secondary">Back to Inventory</a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <p style="color:green;font-weight:bold;padding:10px;">@TempData["SuccessMessage"]</p>
}
@if (TempData["ErrorMessage"] != null)
{
    <p style="color:red;font-weight:bold;padding:10px;">@TempData["ErrorMessage"]</p>
}

<div class="form-container">
    @using (Html.BeginForm("EditVehicle", "Admin", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <input type="hidden" name="CarId" value="@Model.CarId" />

        <div class="form-row">
            <div class="form-group">
                <label>Brand</label>
                <input type="text" name="Brand" class="form-control" value="@Model.Brand" required />
            </div>
            <div class="form-group">
                <label>Model</label>
                <input type="text" name="Model" class="form-control" value="@Model.Model" required />
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Year</label>
                <input type="text" name="Year" class="form-control" value="@Model.Year" required />
            </div>
            <div class="form-group">
                <label>Price ($)</label>
                <input type="number" name="Price" class="form-control" value="@Model.Price" step="0.01" required />
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Fuel Type</label>
                <select name="FuelType" class="form-control">
                    @foreach (var ft in new[] { "Gasoline", "Diesel", "Electric", "Hybrid" })
                    {
                        <option value="@ft" @(Model.FuelType == ft ? "selected" : "")>@ft</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label>Transmission</label>
                <select name="Transmission" class="form-control">
                    @foreach (var t in new[] { "Automatic", "Manual", "CVT" })
                    {
                        <option value="@t" @(Model.Transmission == t ? "selected" : "")>@t</option>
                    }
                </select>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Color</label>
                <input type="text" name="Color" class="form-control" value="@Model.Color" />
            </div>
            <div class="form-group">
                <label>Mileage</label>
                <input type="number" name="Mileage" class="form-control" value="@Model.Mileage" />
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Stock Quantity</label>
                <input type="number" name="StockQuantity" class="form-control" value="@Model.StockQuantity" />
            </div>
            <div class="form-group">
                <label>Image URL</label>
                <input type="text" name="ImageUrl" class="form-control" value="@Model.ImageUrl" />
            </div>
        </div>

        <div class="form-group">
            <label>Description</label>
            <textarea name="Description" class="form-control" rows="4">@Model.Description</textarea>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a href="/Admin/Inventory" class="btn btn-secondary">Cancel</a>
        </div>
    }
</div>

<style>
    .admin-header { background: linear-gradient(135deg, #fd7e14 0%, #e83e8c 100%); color: white; padding: 40px 20px; text-align: center; margin: -30px -30px 40px -30px; border-radius: 8px 8px 0 0; }
    .admin-actions { display: flex; justify-content: center; gap: 15px; margin-top: 20px; }
    .btn { display: inline-block; padding: 10px 20px; border: none; border-radius: 4px; text-decoration: none; cursor: pointer; font-weight: bold; }
    .btn-primary { background: #fd7e14; color: white; }
    .btn-secondary { background: #6c757d; color: white; }
    .form-container { background: white; padding: 30px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); max-width: 900px; margin: 0 auto; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 10px; }
    .form-group { margin-bottom: 15px; }
    .form-group label { display: block; margin-bottom: 5px; font-weight: bold; color: #495057; }
    .form-control { width: 100%; padding: 10px; border: 1px solid #ced4da; border-radius: 4px; font-size: 14px; box-sizing: border-box; }
    .form-actions { display: flex; gap: 15px; margin-top: 20px; }
</style>
