<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ZedCars - @ViewBag.Title</title>
    <style>
        body { 
            font-family: Arial, sans-serif; 
            margin: 0; 
            padding: 0;
            background-color: #f5f5f5;
        }
        .header { 
            background: linear-gradient(135deg, #4b6cb7 0%, #182848 100%); 
            color: white; 
            padding: 20px; 
            position: relative;
        }
        .top-bar {
            display: flex;
            justify-content: flex-end;
            padding: 5px 20px;
            background-color: rgba(0,0,0,0.2);
        }
        .top-bar a {
            color: white;
            text-decoration: none;
            margin-left: 15px;
            font-size: 14px;
        }
        .logo {
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 10px;
        }
        .nav-tabs {
            display: flex;
            margin-top: 20px;
            border-bottom: 1px solid rgba(255,255,255,0.3);
        }
        .nav-tab {
            padding: 10px 20px;
            color: white;
            text-decoration: none;
            border-radius: 5px 5px 0 0;
            margin-right: 5px;
            transition: background-color 0.3s;
        }
        .nav-tab:hover, .nav-tab.active {
            background-color: rgba(255,255,255,0.2);
        }
        .content { 
            background: white; 
            padding: 30px; 
            margin: 20px;
            border-radius: 5px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        .footer { 
            margin-top: 20px; 
            padding: 20px; 
            background: #333; 
            color: white; 
            text-align: center; 
        }
        .disclaimer {
            margin-top: 10px;
            font-size: 14px;
            color: #aaa;
            font-style: italic;
        }
        .btn {
            display: inline-block;
            padding: 8px 16px;
            background-color: #4CAF50;
            color: white;
            text-decoration: none;
            border-radius: 4px;
        }
        .btn-outline {
            background-color: transparent;
            border: 1px solid white;
        }
        
        .car-icon {
            font-style: normal;
            margin-right: 5px;
        }
        
        /* Scrolling disclaimer styles */
        .disclaimer-scroll {
            width: 100%;
            overflow: hidden;
            background-color: rgba(255, 255, 0, 0.1);
            padding: 8px 0;
            margin: 10px 0;
            position: relative;
        }
        
        .scroll-content {
            white-space: nowrap;
            animation: scroll-left 30s linear infinite;
            color: #ffcc00;
            font-weight: bold;
            font-style: italic;
        }
        
        
        scroll-left {
            0% { transform: translateX(100%); }
            100% { transform: translateX(-100%); }
        }
        
        .footer .disclaimer-scroll {
            background-color: rgba(255, 255, 0, 0.05);
        }
    </style>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Calculate the animation duration based on content length
            const headerScroll = document.querySelector('.header .scroll-content');
            const footerScroll = document.querySelector('.footer .scroll-content');
            
            if (headerScroll) {
                const headerWidth = headerScroll.offsetWidth;
                const headerDuration = Math.max(20, headerWidth / 100);
                headerScroll.style.animationDuration = headerDuration + 's';
            }
            
            if (footerScroll) {
                const footerWidth = footerScroll.offsetWidth;
                const footerDuration = Math.max(20, footerWidth / 100);
                footerScroll.style.animationDuration = footerDuration + 's';
            }
        });
    </script>
</head>
<body>
    <div class="header">
        <div class="top-bar">
            @if (Request.IsAuthenticated)
            {
                <span style="color:white;font-size:14px;">[ @User.Identity.Name ]</span>
                <a href="/Account/UserProfile">My Profile</a>
                <a href="/Account/Logout">Logout</a>
            }
            else
            {
                <a href="/Account/Register">Register</a>
                <a href="/Account/Login">Sign In</a>
            }
        </div>
        <div class="disclaimer-scroll">
            <div class="scroll-content">This application for demo purpose only, built to show AWS capabilities in hackathon scenarios, not to be used in production. This application for demo purpose only, built to show AWS capabilities in hackathon scenarios, not to be used in production.</div>
        </div>
        <div class="logo">&#9654; ZedCars</div>
        <p>Your trusted partner for quality vehicles</p>
        
        <div class="nav-tabs">
            <a href="/" class="nav-tab @(Request.Path == "/" ? "active" : "")">Home</a>
            <a href="/Home/Inventory" class="nav-tab @(Request.Path.Contains("/Inventory") ? "active" : "")">Inventory</a>
            <a href="/Home/About" class="nav-tab @(Request.Path.Contains("/About") ? "active" : "")">About</a>
            <a href="/Home/Contact" class="nav-tab @(Request.Path.Contains("/Contact") ? "active" : "")">Contact</a>
            <a href="/Admin/Dashboard" class="nav-tab @(Request.Path.Contains("/Admin") ? "active" : "")">Admin</a>
        </div>
    </div>
    
    <div class="content">
        @RenderBody()
    </div>
    
    <div class="footer">
        <div class="disclaimer-scroll">
            <div class="scroll-content">This application for demo purpose only, built to show AWS capabilities in hackathon scenarios, not to be used in production. This application for demo purpose only, built to show AWS capabilities in hackathon scenarios, not to be used in production.</div>
        </div>
        <p>&copy; @DateTime.Now.Year ZedCars. All rights reserved.</p>
        <p class="disclaimer">Application for learning purpose only, not for production use.</p>
    </div>
</body>
</html>
