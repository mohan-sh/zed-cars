@{
    ViewBag.Title = "Welcome";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ZedCars - Welcome</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #4b6cb7 0%, #182848 100%);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }
        .brand { color: white; text-align: center; margin-bottom: 40px; }
        .brand h1 { font-size: 2.5em; }
        .brand p { opacity: 0.8; margin-top: 8px; }
        .cards {
            display: flex;
            gap: 24px;
            flex-wrap: wrap;
            justify-content: center;
        }
        .card {
            background: white;
            border-radius: 10px;
            padding: 40px 30px;
            text-align: center;
            width: 220px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.2);
            text-decoration: none;
            color: #333;
            transition: transform 0.2s, box-shadow 0.2s;
            display: block;
        }
        .card:hover { transform: translateY(-5px); box-shadow: 0 12px 30px rgba(0,0,0,0.3); }
        .card .icon { font-size: 2.5em; margin-bottom: 15px; }
        .card h2 { font-size: 1.1em; margin-bottom: 8px; }
        .card p { font-size: 0.85em; color: #666; }
        .card.admin { border-top: 4px solid #dc3545; }
        .card.user  { border-top: 4px solid #007bff; }
        .card.reg   { border-top: 4px solid #28a745; }
    </style>
</head>
<body>
    <div class="brand">
        <h1>&#9654; ZedCars</h1>
        <p>Your trusted partner for quality vehicles</p>
    </div>
    <div class="cards">
        <a href="/Account/Register" class="card reg">
            <div class="icon">&#128221;</div>
            <h2>Register</h2>
            <p>Create a new customer account</p>
        </a>
        <a href="/Account/Login" class="card user">
            <div class="icon">&#128100;</div>
            <h2>User Login</h2>
            <p>Sign in to your customer account</p>
        </a>
        <a href="/Account/AdminLogin" class="card admin">
            <div class="icon">&#128274;</div>
            <h2>Admin Login</h2>
            <p>Access the admin dashboard</p>
        </a>
    </div>
</body>
</html>
