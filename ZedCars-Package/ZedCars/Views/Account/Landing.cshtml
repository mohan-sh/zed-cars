@{
    ViewBag.Title = "Welcome";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ZedCars - Welcome</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #4b6cb7 0%, #182848 100%);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }
        .brand { color: white; text-align: center; margin-bottom: 30px; }
        .brand h1 { font-size: 2em; }
        .brand p { opacity: 0.8; margin-top: 6px; font-size: 0.95em; }

        .card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            width: 380px;
            overflow: hidden;
        }

        .tabs {
            display: flex;
            border-bottom: 1px solid #dee2e6;
        }
        .tab {
            flex: 1;
            padding: 14px;
            text-align: center;
            cursor: pointer;
            font-weight: bold;
            font-size: 0.9em;
            color: #6c757d;
            background: #f8f9fa;
            border-bottom: 3px solid transparent;
            transition: all 0.2s;
        }
        .tab:hover { background: #e9ecef; }
        .tab.active { background: white; color: #4b6cb7; border-bottom-color: #4b6cb7; }
        .tab.admin.active { color: #dc3545; border-bottom-color: #dc3545; }

        .pane { display: none; padding: 30px; }
        .pane.active { display: block; }

        .form-group { margin-bottom: 16px; }
        .form-group label { display: block; margin-bottom: 5px; font-size: 0.85em; font-weight: bold; color: #495057; }
        .form-group input {
            width: 100%; padding: 10px 12px;
            border: 1px solid #ced4da; border-radius: 6px;
            font-size: 0.95em; transition: border-color 0.2s;
        }
        .form-group input:focus { outline: none; border-color: #4b6cb7; box-shadow: 0 0 0 2px rgba(75,108,183,0.2); }

        .btn {
            width: 100%; padding: 11px;
            border: none; border-radius: 6px;
            font-size: 1em; font-weight: bold;
            cursor: pointer; color: white; transition: background 0.2s;
        }
        .btn-user  { background: #4b6cb7; }
        .btn-user:hover  { background: #3a5a9b; }
        .btn-admin { background: #dc3545; }
        .btn-admin:hover { background: #b02a37; }
        .btn-reg   { background: #28a745; }
        .btn-reg:hover   { background: #1e7e34; }

        .alert { padding: 10px 12px; border-radius: 6px; margin-bottom: 16px; font-size: 0.9em; }
        .alert-danger { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }
        .alert-success { background: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
    </style>
</head>
<body>
    <div class="brand">
        <h1>&#9654; ZedCars</h1>
        <p>Your trusted partner for quality vehicles</p>
    </div>

    <div class="card">
        <div class="tabs">
            <div class="tab active"       onclick="showTab('register')">&#128221; Register</div>
            <div class="tab"              onclick="showTab('user')">&#128100; User Login</div>
            <div class="tab admin"        onclick="showTab('admin')">&#128274; Admin Login</div>
        </div>

        <!-- Register -->
        <div class="pane active" id="pane-register">
            @if (TempData["RegError"] != null)   { <div class="alert alert-danger">@TempData["RegError"]</div> }
            @if (TempData["RegSuccess"] != null) { <div class="alert alert-success">@TempData["RegSuccess"]</div> }
            <form method="post" action="/Account/Register">
                <div class="form-group">
                    <label>Full Name</label>
                    <input type="text" name="fullName" required />
                </div>
                <div class="form-group">
                    <label>Username</label>
                    <input type="text" name="username" required />
                </div>
                <div class="form-group">
                    <label>Password</label>
                    <input type="password" name="password" required />
                </div>
                <button type="submit" class="btn btn-reg">Register</button>
            </form>
        </div>

        <!-- User Login -->
        <div class="pane" id="pane-user">
            @if (TempData["UserError"] != null) { <div class="alert alert-danger">@TempData["UserError"]</div> }
            <form method="post" action="/Account/Login">
                <div class="form-group">
                    <label>Username</label>
                    <input type="text" name="username" required />
                </div>
                <div class="form-group">
                    <label>Password</label>
                    <input type="password" name="password" required />
                </div>
                <button type="submit" class="btn btn-user">Sign In</button>
            </form>
        </div>

        <!-- Admin Login -->
        <div class="pane" id="pane-admin">
            @if (TempData["AdminError"] != null) { <div class="alert alert-danger">@TempData["AdminError"]</div> }
            <form method="post" action="/Account/AdminLogin">
                <div class="form-group">
                    <label>Admin Username</label>
                    <input type="text" name="username" required />
                </div>
                <div class="form-group">
                    <label>Password</label>
                    <input type="password" name="password" required />
                </div>
                <button type="submit" class="btn btn-admin">Admin Sign In</button>
            </form>
        </div>
    </div>

    <script>
        function showTab(name) {
            document.querySelectorAll('.tab').forEach((t, i) => {
                t.classList.toggle('active', ['register','user','admin'][i] === name);
            });
            document.querySelectorAll('.pane').forEach(p => p.classList.remove('active'));
            document.getElementById('pane-' + name).classList.add('active');
        }

        // Auto-open correct tab if there's an error
        @if (TempData["ActiveTab"] != null) {
            <text>showTab('@TempData["ActiveTab"]');</text>
        }
    </script>
</body>
</html>
