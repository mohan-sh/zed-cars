@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_SimpleLayout.cshtml";
}

<div class="login-container">
    <div class="login-form">
        <h1>Sign In</h1>
        <p class="subtitle">Access your ZedCars account</p>
        
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                @TempData["ErrorMessage"]
            </div>
        }
        
        <form action="/Account/Login" method="post">
            <div class="form-group">
                <label for="username">Username</label>
                <input type="text" id="username" name="username" class="form-control" required />
            </div>
            
            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" class="form-control" required />
            </div>
            
            <div class="form-group remember-me">
                <input type="checkbox" id="remember" name="remember" />
                <label for="remember">Remember me</label>
            </div>
            
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Sign In</button>
            </div>
            
            <div class="form-footer">
                <p>Don't have an account? <a href="/Account/Register">Register</a></p>
                <p><a href="/Account/ForgotPassword">Forgot your password?</a></p>
            </div>
        </form>
        
        <div class="demo-accounts">
            <h3>Demo Accounts</h3>
            <div class="demo-table">
                <table>
                    <thead>
                        <tr>
                            <th>Username</th>
                            <th>Password</th>
                            <th>Role</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>admin</td>
                            <td>admin123</td>
                            <td>Administrator</td>
                        </tr>
                        <tr>
                            <td>user1</td>
                            <td>password1</td>
                            <td>Customer</td>
                        </tr>
                        <tr>
                            <td>user2</td>
                            <td>password2</td>
                            <td>Customer</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    
    <div class="login-info">
        <h2>Welcome Back!</h2>
        <p>Sign in to access your ZedCars account and enjoy these benefits:</p>
        
        <div class="benefit-list">
            <div class="benefit-item">
                <div class="benefit-icon">🔍</div>
                <div class="benefit-text">
                    <h3>Browse Full Inventory</h3>
                    <p>Access our complete collection of premium vehicles</p>
                </div>
            </div>
            
            <div class="benefit-item">
                <div class="benefit-icon">❤️</div>
                <div class="benefit-text">
                    <h3>Save Favorites</h3>
                    <p>Create a list of your favorite vehicles for later</p>
                </div>
            </div>
            
            <div class="benefit-item">
                <div class="benefit-icon">📅</div>
                <div class="benefit-text">
                    <h3>Schedule Test Drives</h3>
                    <p>Book appointments to test drive your selected vehicles</p>
                </div>
            </div>
            
            <div class="benefit-item">
                <div class="benefit-icon">💰</div>
                <div class="benefit-text">
                    <h3>Get Financing</h3>
                    <p>Apply for financing and get pre-approved instantly</p>
                </div>
            </div>
            
            <div class="benefit-item">
                <div class="benefit-icon">🔧</div>
                <div class="benefit-text">
                    <h3>Service History</h3>
                    <p>Track your vehicle's service history and schedule maintenance</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .login-container {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        max-width: 1000px;
        margin: 0 auto;
        padding: 20px;
    }
    
    .login-form {
        background: white;
        padding: 40px;
        border-radius: 8px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }
    
    .login-form h1 {
        color: #343a40;
        margin-bottom: 10px;
        text-align: center;
    }
    
    .subtitle {
        text-align: center;
        color: #6c757d;
        margin-bottom: 30px;
    }
    
    .alert {
        padding: 12px;
        border-radius: 4px;
        margin-bottom: 20px;
    }
    
    .alert-danger {
        background-color: #f8d7da;
        border: 1px solid #f5c6cb;
        color: #721c24;
    }
    
    .form-group {
        margin-bottom: 20px;
    }
    
    .form-group label {
        display: block;
        margin-bottom: 5px;
        font-weight: bold;
        color: #495057;
    }
    
    .form-control {
        width: 100%;
        padding: 12px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        font-size: 16px;
        transition: border-color 0.3s;
    }
    
    .form-control:focus {
        outline: none;
        border-color: #007bff;
        box-shadow: 0 0 0 2px rgba(0, 123, 255, 0.25);
    }
    
    .remember-me {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    
    .remember-me input[type="checkbox"] {
        width: auto;
    }
    
    .form-actions {
        margin-bottom: 20px;
    }
    
    .btn {
        display: inline-block;
        padding: 12px 24px;
        border: none;
        border-radius: 4px;
        text-decoration: none;
        text-align: center;
        cursor: pointer;
        font-weight: bold;
        transition: all 0.3s;
        width: 100%;
    }
    
    .btn-primary {
        background: #007bff;
        color: white;
    }
    
    .btn-primary:hover {
        background: #0056b3;
    }
    
    .form-footer {
        text-align: center;
        border-top: 1px solid #dee2e6;
        padding-top: 20px;
    }
    
    .form-footer a {
        color: #007bff;
        text-decoration: none;
    }
    
    .form-footer a:hover {
        text-decoration: underline;
    }
    
    .demo-accounts {
        margin-top: 30px;
        padding: 20px;
        background: #f8f9fa;
        border-radius: 8px;
    }
    
    .demo-accounts h3 {
        margin-bottom: 15px;
        color: #495057;
        text-align: center;
    }
    
    .demo-table table {
        width: 100%;
        border-collapse: collapse;
    }
    
    .demo-table th,
    .demo-table td {
        padding: 8px 12px;
        text-align: left;
        border-bottom: 1px solid #dee2e6;
    }
    
    .demo-table th {
        background: #e9ecef;
        font-weight: bold;
        color: #495057;
    }
    
    .demo-table td {
        color: #6c757d;
        font-family: monospace;
    }
    
    .login-info {
        padding: 40px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 8px;
    }
    
    .login-info h2 {
        margin-bottom: 15px;
    }
    
    .login-info > p {
        margin-bottom: 30px;
        opacity: 0.9;
    }
    
    .benefit-list {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }
    
    .benefit-item {
        display: flex;
        align-items: flex-start;
        gap: 15px;
    }
    
    .benefit-icon {
        font-size: 2em;
        flex-shrink: 0;
    }
    
    .benefit-text h3 {
        margin: 0 0 5px 0;
        font-size: 1.1em;
    }
    
    .benefit-text p {
        margin: 0;
        opacity: 0.8;
        font-size: 0.9em;
    }
    
    @@media (max-width: 768px) {
        .login-container {
            grid-template-columns: 1fr;
            gap: 20px;
            padding: 10px;
        }
        
        .login-form,
        .login-info {
            padding: 20px;
        }
    }
</style>
