@{
    ViewBag.Title = "Vehicle Details";
    Layout = "~/Views/Shared/_SimpleLayout.cshtml";
}

<div class="vehicle-detail-header">
    <h1>Vehicle Details</h1>
    <p class="lead">Complete information about your selected vehicle</p>
</div>

<div class="vehicle-detail-content">
    <div class="vehicle-main">
        <div class="vehicle-images">
            <div class="main-image">
                <img id="main-vehicle-image" src="https://images.unsplash.com/photo-1555215695-3004980ad54e?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Vehicle Main Image" />
            </div>
            <div class="thumbnail-images">
                <img class="thumbnail active" src="https://images.unsplash.com/photo-1555215695-3004980ad54e?ixlib=rb-4.0.3&auto=format&fit=crop&w=150&q=60" alt="View 1" onclick="changeMainImage(this.src)" />
                <img class="thumbnail" src="https://images.unsplash.com/photo-1606664515524-ed2f786a0bd6?ixlib=rb-4.0.3&auto=format&fit=crop&w=150&q=60" alt="View 2" onclick="changeMainImage(this.src)" />
                <img class="thumbnail" src="https://images.unsplash.com/photo-1605893477799-b99e3b8b93fe?ixlib=rb-4.0.3&auto=format&fit=crop&w=150&q=60" alt="View 3" onclick="changeMainImage(this.src)" />
            </div>
        </div>
        
        <div class="vehicle-info">
            <h2 id="vehicle-title">BMW 5 Series</h2>
            <p class="vehicle-price" id="vehicle-price">$55,000</p>
            <p class="vehicle-year" id="vehicle-year">2023 Model</p>
            
            <div class="vehicle-specs">
                <h3>Specifications</h3>
                <div class="specs-grid">
                    <div class="spec-item">
                        <span class="spec-label">Engine:</span>
                        <span class="spec-value">3.0L Turbo I6</span>
                    </div>
                    <div class="spec-item">
                        <span class="spec-label">Transmission:</span>
                        <span class="spec-value">8-Speed Automatic</span>
                    </div>
                    <div class="spec-item">
                        <span class="spec-label">Fuel Economy:</span>
                        <span class="spec-value">26 MPG Combined</span>
                    </div>
                    <div class="spec-item">
                        <span class="spec-label">Drivetrain:</span>
                        <span class="spec-value">All-Wheel Drive</span>
                    </div>
                    <div class="spec-item">
                        <span class="spec-label">Seating:</span>
                        <span class="spec-value">5 Passengers</span>
                    </div>
                    <div class="spec-item">
                        <span class="spec-label">Color:</span>
                        <span class="spec-value">Mineral Gray Metallic</span>
                    </div>
                </div>
            </div>
            
            <div class="vehicle-features">
                <h3>Key Features</h3>
                <ul class="features-list">
                    <li>✓ Premium Leather Seats</li>
                    <li>✓ Navigation System</li>
                    <li>✓ Heated & Ventilated Seats</li>
                    <li>✓ Panoramic Sunroof</li>
                    <li>✓ Advanced Safety Package</li>
                    <li>✓ Wireless Phone Charging</li>
                    <li>✓ Premium Sound System</li>
                    <li>✓ Adaptive Cruise Control</li>
                </ul>
            </div>
            
            <div class="action-buttons">
                <button class="btn btn-primary btn-large">Schedule Test Drive</button>
                <button class="btn btn-secondary btn-large">Get Financing</button>
                <button class="btn btn-outline btn-large">Contact Dealer</button>
            </div>
        </div>
    </div>
    
    <div class="vehicle-description">
        <h3>Description</h3>
        <p>This stunning BMW 5 Series represents the perfect balance of luxury, performance, and technology. With its sophisticated design and advanced engineering, this vehicle delivers an exceptional driving experience that BMW is renowned for.</p>
        
        <p>The interior features premium materials throughout, including fine leather upholstery and real wood trim. The latest iDrive infotainment system keeps you connected while advanced safety features provide peace of mind on every journey.</p>
        
        <p>Under the hood, the turbocharged engine delivers impressive performance while maintaining excellent fuel efficiency. Whether you're commuting to work or embarking on a weekend adventure, this BMW 5 Series is ready to exceed your expectations.</p>
    </div>
    
    <div class="similar-vehicles">
        <h3>Similar Vehicles</h3>
        <div class="similar-grid">
            <div class="similar-card">
                <img src="https://images.unsplash.com/photo-1560958089-b8a1929cea89?ixlib=rb-4.0.3&auto=format&fit=crop&w=200&q=60" alt="Tesla Model 3" />
                <h4>Tesla Model 3</h4>
                <p class="similar-price">$60,000</p>
                <a href="/Home/VehicleDetail/5" class="btn btn-sm">View Details</a>
            </div>
            
            <div class="similar-card">
                <img src="https://images.unsplash.com/photo-1621007947382-bb3c3994e3fb?ixlib=rb-4.0.3&auto=format&fit=crop&w=200&q=60" alt="Toyota Camry" />
                <h4>Toyota Camry</h4>
                <p class="similar-price">$25,000</p>
                <a href="/Home/VehicleDetail/1" class="btn btn-sm">View Details</a>
            </div>
            
            <div class="similar-card">
                <img src="https://images.unsplash.com/photo-1606664515524-ed2f786a0bd6?ixlib=rb-4.0.3&auto=format&fit=crop&w=200&q=60" alt="Honda CR-V" />
                <h4>Honda CR-V</h4>
                <p class="similar-price">$35,000</p>
                <a href="/Home/VehicleDetail/2" class="btn btn-sm">View Details</a>
            </div>
        </div>
    </div>
</div>

<style>
    .vehicle-detail-header {
        background: linear-gradient(135deg, #6f42c1 0%, #e83e8c 100%);
        color: white;
        padding: 40px 20px;
        text-align: center;
        margin: -30px -30px 40px -30px;
        border-radius: 8px 8px 0 0;
    }
    
    .vehicle-main {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        margin-bottom: 40px;
    }
    
    .vehicle-images {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }
    
    .main-image {
        width: 100%;
        height: 400px;
        overflow: hidden;
        border-radius: 8px;
    }
    
    .main-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    
    .thumbnail-images {
        display: flex;
        gap: 10px;
    }
    
    .thumbnail {
        width: 80px;
        height: 60px;
        object-fit: cover;
        border-radius: 4px;
        cursor: pointer;
        border: 2px solid transparent;
        transition: border-color 0.3s;
    }
    
    .thumbnail.active,
    .thumbnail:hover {
        border-color: #007bff;
    }
    
    .vehicle-info h2 {
        color: #343a40;
        margin-bottom: 10px;
    }
    
    .vehicle-price {
        font-size: 2em;
        font-weight: bold;
        color: #28a745;
        margin-bottom: 10px;
    }
    
    .vehicle-year {
        color: #6c757d;
        margin-bottom: 30px;
    }
    
    .vehicle-specs,
    .vehicle-features {
        margin-bottom: 30px;
    }
    
    .specs-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-top: 15px;
    }
    
    .spec-item {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px solid #dee2e6;
    }
    
    .spec-label {
        font-weight: bold;
        color: #495057;
    }
    
    .spec-value {
        color: #6c757d;
    }
    
    .features-list {
        list-style: none;
        padding: 0;
        margin-top: 15px;
    }
    
    .features-list li {
        padding: 5px 0;
        color: #495057;
    }
    
    .action-buttons {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 30px;
    }
    
    .btn {
        padding: 12px 24px;
        border: none;
        border-radius: 4px;
        text-decoration: none;
        text-align: center;
        cursor: pointer;
        font-weight: bold;
        transition: all 0.3s;
    }
    
    .btn-large {
        padding: 15px 30px;
        font-size: 1.1em;
    }
    
    .btn-primary {
        background: #007bff;
        color: white;
    }
    
    .btn-secondary {
        background: #6c757d;
        color: white;
    }
    
    .btn-outline {
        background: transparent;
        border: 2px solid #007bff;
        color: #007bff;
    }
    
    .btn-sm {
        padding: 6px 12px;
        font-size: 0.9em;
    }
    
    .vehicle-description {
        background: #f8f9fa;
        padding: 30px;
        border-radius: 8px;
        margin-bottom: 40px;
        line-height: 1.6;
    }
    
    .similar-vehicles {
        margin-top: 40px;
    }
    
    .similar-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }
    
    .similar-card {
        background: white;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        text-align: center;
        padding: 15px;
    }
    
    .similar-card img {
        width: 100%;
        height: 120px;
        object-fit: cover;
        border-radius: 4px;
        margin-bottom: 10px;
    }
    
    .similar-card h4 {
        margin: 10px 0 5px 0;
        color: #343a40;
    }
    
    .similar-price {
        font-weight: bold;
        color: #28a745;
        margin-bottom: 10px;
    }
    
    @@media (max-width: 768px) {
        .vehicle-main {
            grid-template-columns: 1fr;
        }
        
        .specs-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<script>
    function changeMainImage(src) {
        document.getElementById('main-vehicle-image').src = src.replace('w=150', 'w=600');
        
        // Update active thumbnail
        document.querySelectorAll('.thumbnail').forEach(thumb => {
            thumb.classList.remove('active');
        });
        event.target.classList.add('active');
    }
    
    // Simulate dynamic content based on URL parameter
    document.addEventListener('DOMContentLoaded', function() {
        const urlParams = new URLSearchParams(window.location.search);
        const vehicleId = window.location.pathname.split('/').pop();
        
        // This would normally fetch data from server based on vehicleId
        // For demo purposes, we'll just show different content
        if (vehicleId === '1') {
            document.getElementById('vehicle-title').textContent = 'Toyota Camry';
            document.getElementById('vehicle-price').textContent = '$25,000';
        } else if (vehicleId === '2') {
            document.getElementById('vehicle-title').textContent = 'Honda CR-V';
            document.getElementById('vehicle-price').textContent = '$35,000';
        } else if (vehicleId === '3') {
            document.getElementById('vehicle-title').textContent = 'Ford F-150';
            document.getElementById('vehicle-price').textContent = '$45,000';
        } else if (vehicleId === '5') {
            document.getElementById('vehicle-title').textContent = 'Tesla Model 3';
            document.getElementById('vehicle-price').textContent = '$60,000';
        }
    });
</script>
