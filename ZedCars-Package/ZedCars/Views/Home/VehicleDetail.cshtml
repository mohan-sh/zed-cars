@model ZedCars.Models.Car
@{
    ViewBag.Title = Model.Brand + " " + Model.Model;
    Layout = "~/Views/Shared/_SimpleLayout.cshtml";
}

<div class="vehicle-detail-header">
    <h1>@Model.Brand @Model.Model</h1>
    <p class="lead">@Model.Year &nbsp;|&nbsp; @Model.FuelType &nbsp;|&nbsp; @Model.Transmission</p>
</div>

<div class="vehicle-detail-content">
    <div class="vehicle-main">
        <div class="vehicle-images">
            <div class="main-image">
                <img src="@Model.ImageUrl" alt="@Model.Brand @Model.Model" onerror="this.src='https://via.placeholder.com/600x400?text=No+Image'" />
            </div>
        </div>

        <div class="vehicle-info">
            <h2>@Model.Brand @Model.Model</h2>
            <p class="vehicle-price">$@Model.Price.ToString("N0")</p>
            <p class="vehicle-year">@Model.Year Model</p>

            <div class="vehicle-specs">
                <h3>Specifications</h3>
                <div class="specs-grid">
                    <div class="spec-item">
                        <span class="spec-label">Brand:</span>
                        <span class="spec-value">@Model.Brand</span>
                    </div>
                    <div class="spec-item">
                        <span class="spec-label">Model:</span>
                        <span class="spec-value">@Model.Model</span>
                    </div>
                    <div class="spec-item">
                        <span class="spec-label">Year:</span>
                        <span class="spec-value">@Model.Year</span>
                    </div>
                    <div class="spec-item">
                        <span class="spec-label">Fuel Type:</span>
                        <span class="spec-value">@Model.FuelType</span>
                    </div>
                    <div class="spec-item">
                        <span class="spec-label">Transmission:</span>
                        <span class="spec-value">@Model.Transmission</span>
                    </div>
                    <div class="spec-item">
                        <span class="spec-label">Stock:</span>
                        <span class="spec-value">@Model.StockQuantity available</span>
                    </div>
                </div>
            </div>

            <div class="action-buttons">
                <a href="/Home/Inventory" class="btn btn-outline btn-large">Back to Inventory</a>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <div class="vehicle-description">
            <h3>Description</h3>
            <p>@Model.Description</p>
        </div>
    }
</div>

<style>
    .vehicle-detail-header {
        background: linear-gradient(135deg, #6f42c1 0%, #e83e8c 100%);
        color: white;
        padding: 40px 20px;
        text-align: center;
        margin: -30px -30px 40px -30px;
        border-radius: 8px 8px 0 0;
    }
    .vehicle-main {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        margin-bottom: 40px;
    }
    .main-image { width: 100%; height: 400px; overflow: hidden; border-radius: 8px; }
    .main-image img { width: 100%; height: 100%; object-fit: cover; }
    .vehicle-price { font-size: 2em; font-weight: bold; color: #28a745; margin-bottom: 10px; }
    .vehicle-year { color: #6c757d; margin-bottom: 30px; }
    .specs-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 15px; }
    .spec-item { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #dee2e6; }
    .spec-label { font-weight: bold; color: #495057; }
    .spec-value { color: #6c757d; }
    .action-buttons { margin-top: 30px; }
    .btn { display: inline-block; padding: 12px 24px; border-radius: 4px; text-decoration: none; font-weight: bold; transition: all 0.3s; }
    .btn-large { padding: 15px 30px; font-size: 1.1em; }
    .btn-outline { background: transparent; border: 2px solid #007bff; color: #007bff; }
    .vehicle-description { background: #f8f9fa; padding: 30px; border-radius: 8px; line-height: 1.6; }
    @@media (max-width: 768px) {
        .vehicle-main { grid-template-columns: 1fr; }
        .specs-grid { grid-template-columns: 1fr; }
    }
</style>
