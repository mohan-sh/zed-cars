@model List<ZedCars.Models.Car>
@{
    ViewBag.Title = "Home";
    Layout = "~/Views/Shared/_SimpleLayout.cshtml";
}

<div class="hero-section">
    <h1>Welcome to ZedCars</h1>
    <p class="lead">Discover our premium collection of vehicles and automotive accessories</p>
    @*<p class="disclaimer-banner">Application for demo purpose only, built to show AWS capabilities in hackathon scenarios, not to be used in production.</p>*@
    <div class="hero-buttons">
        <a href="/Home/Inventory" class="btn btn-primary">Browse Inventory</a>
        <a href="/Home/Contact" class="btn btn-outline">Contact Us</a>
    </div>
</div>

<div class="inventory-section">
    <h2>Our Vehicle Inventory</h2>
    <p>Browse our carefully selected collection of quality vehicles from trusted manufacturers.</p>
    
    <div class="stats-grid">
        <div class="stat-card">
            <h3>23+</h3>
            <p>Vehicles Available</p>
        </div>
        <div class="stat-card">
            <h3>8</h3>
            <p>Premium Brands</p>
        </div>
        <div class="stat-card">
            <h3>20+</h3>
            <p>Accessories</p>
        </div>
        <div class="stat-card">
            <h3>100%</h3>
            <p>Quality Guaranteed</p>
        </div>
    </div>

    <div class="brands-section">
        <h3>Featured Brands</h3>
        <div class="brands-grid">
            <div class="brand-item">Toyota</div>
            <div class="brand-item">Honda</div>
            <div class="brand-item">Ford</div>
            <div class="brand-item">BMW</div>
            <div class="brand-item">Mercedes</div>
            <div class="brand-item">Audi</div>
            <div class="brand-item">Tesla</div>
            <div class="brand-item">Jeep</div>
        </div>
    </div>

    <div class="featured-vehicles">
        <h3>Featured Vehicles</h3>
        <div class="vehicle-grid">
            @if (Model != null && Model.Count > 0)
            {
                foreach (var car in Model)
                {
                    <div class="vehicle-card">
                        <div class="vehicle-image">
                            <img src="@car.ImageUrl" alt="@car.Brand @car.Model" onerror="this.src='https://via.placeholder.com/300x200?text=No+Image'" />
                        </div>
                        <div class="vehicle-details">
                            <h4>@car.Brand @car.Model</h4>
                            <p class="vehicle-price">$@car.Price.ToString("N0")</p>
                            <p class="vehicle-desc">@car.Year | @car.FuelType | @car.Transmission</p>
                            <a href="/Home/VehicleDetail/@car.CarId" class="btn btn-sm">View Details</a>
                        </div>
                    </div>
                }
            }
            else
            {
                <p>No featured vehicles available.</p>
            }
        </div>
        
        <div class="view-all-link">
            <a href="/Home/Inventory" class="btn">View All Vehicles</a>
        </div>
    </div>

    <div class="cta-section">
        <h3>Ready to Find Your Perfect Vehicle?</h3>
        <p>Contact our expert team to explore our inventory and find the vehicle that's right for you.</p>
        <div class="cta-buttons">
            <a href="/Home/Contact" class="btn btn-primary">Contact Us Today</a>
            <a href="/Home/About" class="btn btn-outline">Learn More About Us</a>
        </div>
    </div>
</div>

<div class="site-map">
    <h3>Site Navigation</h3>
    <div class="site-map-grid">
        <div class="site-map-column">
            <h4>Vehicle Pages</h4>
            <ul>
                <li><a href="/Home/Inventory">Vehicle Inventory</a></li>
                <li><a href="/Home/VehicleDetail/4">BMW 5 Series</a></li>
                <li><a href="/Home/VehicleDetail/5">Tesla Model 3</a></li>
                <li><a href="/Home/VehicleDetail/3">Ford F-150</a></li>
            </ul>
        </div>
        
        <div class="site-map-column">
            <h4>Information</h4>
            <ul>
                <li><a href="/Home/About">About Us</a></li>
                <li><a href="/Home/Contact">Contact Us</a></li>
                <li><a href="/Home/Direct">Direct View</a></li>
                <li><a href="/Home/Test">Test Page</a></li>
            </ul>
        </div>
        
        <div class="site-map-column">
            <h4>Account</h4>
            <ul>
                <li><a href="/Account/Login">Sign In</a></li>
                <li><a href="/Account/Register">Register</a></li>
                <li><a href="/Admin/Dashboard">Admin Dashboard</a></li>
            </ul>
        </div>
    </div>
</div>

<style>
    .hero-section {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
        padding: 60px 20px;
        text-align: center;
        margin: -30px -30px 40px -30px;
        border-radius: 8px 8px 0 0;
    }
    
    .disclaimer-banner {
        background-color: rgba(0,0,0,0.2);
        padding: 10px;
        border-radius: 5px;
        margin: 15px auto;
        max-width: 600px;
        font-style: italic;
    }
    
    .hero-buttons {
        margin-top: 30px;
        display: flex;
        justify-content: center;
        gap: 15px;
    }
    
    .btn {
        display: inline-block;
        padding: 12px 24px;
        border-radius: 4px;
        text-decoration: none;
        font-weight: bold;
        transition: all 0.3s ease;
    }
    
    .btn-primary {
        background: #007bff;
        color: white;
    }
    
    .btn-outline {
        background: transparent;
        border: 2px solid white;
        color: white;
    }
    
    .btn-sm {
        padding: 8px 16px;
        font-size: 14px;
    }
    
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin: 30px 0;
    }
    
    .stat-card {
        background: #f8f9fa;
        padding: 30px;
        text-align: center;
        border-radius: 8px;
        border-left: 4px solid #28a745;
    }
    
    .stat-card h3 {
        font-size: 2.5em;
        color: #28a745;
        margin: 0 0 10px 0;
    }
    
    .brands-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 15px;
        margin: 20px 0;
    }
    
    .brand-item {
        background: #007bff;
        color: white;
        padding: 20px;
        text-align: center;
        border-radius: 8px;
        font-weight: bold;
    }
    
    .featured-vehicles {
        margin: 40px 0;
    }
    
    .vehicle-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
        margin: 20px 0;
    }
    
    .vehicle-card {
        background: white;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease;
    }
    
    .vehicle-card:hover {
        transform: translateY(-5px);
    }
    
    .vehicle-image {
        height: 200px;
        overflow: hidden;
    }
    
    .vehicle-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    
    .vehicle-details {
        padding: 20px;
    }
    
    .vehicle-price {
        font-weight: bold;
        color: #28a745;
        margin: 5px 0;
    }
    
    .vehicle-desc {
        color: #6c757d;
        margin-bottom: 15px;
    }
    
    .view-all-link {
        text-align: center;
        margin-top: 30px;
    }
    
    .cta-section {
        background: #f8f9fa;
        padding: 40px;
        text-align: center;
        border-radius: 8px;
        margin-top: 40px;
    }
    
    .cta-buttons {
        display: flex;
        justify-content: center;
        gap: 15px;
        margin-top: 20px;
    }
    
    .cta-buttons .btn-outline {
        border-color: #6c757d;
        color: #6c757d;
    }
    
    .site-map {
        margin-top: 60px;
        padding-top: 30px;
        border-top: 1px solid #dee2e6;
    }
    
    .site-map-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 30px;
        margin-top: 20px;
    }
    
    .site-map-column h4 {
        margin-bottom: 15px;
        color: #343a40;
    }
    
    .site-map-column ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    
    .site-map-column li {
        margin-bottom: 10px;
    }
    
    .site-map-column a {
        color: #007bff;
        text-decoration: none;
    }
    
    .site-map-column a:hover {
        text-decoration: underline;
    }
</style>
