@{
    ViewBag.Title = "Contact";
    Layout = "~/Views/Shared/_SimpleLayout.cshtml";
}

<div class="contact-header">
    <h1>Contact Us</h1>
    <p class="lead">We'd love to hear from you</p>
</div>

<div class="contact-content">
    <div class="contact-grid">
        <div class="contact-info">
            <h2>Get In Touch</h2>
            <p>Have questions about our vehicles or services? Our team is here to help.</p>
            
            <div class="info-item">
                <h3>📍 Address</h3>
                <p>123 Auto Avenue<br>Cartown, CT 12345</p>
            </div>
            
            <div class="info-item">
                <h3>📞 Phone</h3>
                <p>Sales: (555) 123-4567<br>Service: (555) 123-4568</p>
            </div>
            
            <div class="info-item">
                <h3>✉️ Email</h3>
                <p>info@zedcars.example<br>support@zedcars.example</p>
            </div>
            
            <div class="info-item">
                <h3>🕒 Hours</h3>
                <p>Monday - Friday: 9am - 7pm<br>Saturday: 10am - 5pm<br>Sunday: Closed</p>
            </div>
        </div>
        
        <div class="contact-form">
            <h2>Send Us a Message</h2>
            <form>
                <div class="form-group">
                    <label for="name">Name</label>
                    <input type="text" id="name" name="name" class="form-control" required />
                </div>
                
                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" class="form-control" required />
                </div>
                
                <div class="form-group">
                    <label for="phone">Phone</label>
                    <input type="tel" id="phone" name="phone" class="form-control" />
                </div>
                
                <div class="form-group">
                    <label for="subject">Subject</label>
                    <select id="subject" name="subject" class="form-control">
                        <option value="sales">Sales Inquiry</option>
                        <option value="service">Service Request</option>
                        <option value="parts">Parts Inquiry</option>
                        <option value="other">Other</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label for="message">Message</label>
                    <textarea id="message" name="message" rows="5" class="form-control" required></textarea>
                </div>
                
                <button type="submit" class="btn btn-primary">Send Message</button>
            </form>
        </div>
    </div>
    
    <div class="map-section">
        <h2>Find Us</h2>
        <div class="map-placeholder">
            <p>Map would be displayed here in a real application</p>
        </div>
    </div>
</div>

<style>
    .contact-header {
        background: linear-gradient(135deg, #fd7e14 0%, #e83e8c 100%);
        color: white;
        padding: 60px 20px;
        text-align: center;
        margin: -30px -30px 40px -30px;
        border-radius: 8px 8px 0 0;
    }
    
    .contact-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 30px;
        margin-bottom: 40px;
    }
    
    .info-item {
        margin-bottom: 20px;
    }
    
    .info-item h3 {
        color: #fd7e14;
        margin-bottom: 5px;
    }
    
    .form-group {
        margin-bottom: 20px;
    }
    
    .form-group label {
        display: block;
        margin-bottom: 5px;
        font-weight: bold;
    }
    
    .form-control {
        width: 100%;
        padding: 10px;
        border: 1px solid #ced4da;
        border-radius: 4px;
    }
    
    textarea.form-control {
        resize: vertical;
    }
    
    .btn-primary {
        background: #fd7e14;
        color: white;
        padding: 10px 20px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
    }
    
    .btn-primary:hover {
        background: #e96b02;
    }
    
    .map-placeholder {
        background: #f8f9fa;
        height: 300px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        border: 1px solid #dee2e6;
    }
</style>
